ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./database/parently.db
TEST_DATABASE_URL=sqlite:///:memory:

# JWT Authentication
JWT_SECRET=change-me-to-a-32+-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_SECRET=change-me-to-a-strong-otp-secret
OTP_EXPIRE_MINUTES=10

# Groq AI (offline fallback is used when empty)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB (optional)
CHROMADB_HOST=
CHROMADB_PORT=8000
CHROMADB_PATH=
CHROMADB_COLLECTION_PREFIX=parently

# Redis / Celery (REQUIRED for the notification & reminder system)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Scheduler (crontab, UTC)
SCHEDULER_TIMEZONE=UTC

# Email - SMTP / Brevo
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Parently <parently.care@gmail.com>"

# Push - FCM (optional; notifications still work in-app without it)
FCM_SERVER_KEY=
FCM_SENDER_ID=

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_REQUESTS_PER_MINUTE=60
