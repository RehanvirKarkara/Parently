# Parently Frontend environment variables.
# Copy to .env.local for local development. None of these are secrets.

# Base URL of the FastAPI backend (used only when VITE_USE_MOCK=false).
VITE_API_URL=/api/v1

# When true/unset the app uses the in-memory mock API layer (no backend needed).
# Set to "false" to hit the real backend.
VITE_USE_MOCK=true
